  <actions>
    <action caption="Klik kelas untuk detail" name="[ActionKP]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Dashboard Potensi Site" type="sheet" worksheet="Distribusi Kelas" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Distribusi Kelas,Profil Kelas,Jumlah Site,Median Penggunaan,Site Kelas Tinggi" />
        <param name="special-fields" value="all" />
        <param name="target" value="Dashboard Potensi Site" />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name="Jumlah Site">
      <table>
        <view>
          <datasources>
            <datasource caption="Potensi Site - hasil KP" name="kp" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="kp">
            <column caption="Site Id" datatype="string" name="[site_id]" role="dimension" type="nominal" />
            <column caption="Month" datatype="string" name="[month]" role="dimension" type="nominal" />
            <column caption="Days Observed" datatype="real" name="[days_observed]" role="measure" type="quantitative" default-format="n#,##0" />
            <column caption="Site Coverage Available" datatype="real" name="[site_coverage_available]" role="measure" type="quantitative" default-format="p0.0%" />
            <column caption="Calendar Coverage" datatype="real" name="[calendar_coverage]" role="measure" type="quantitative" default-format="p0.0%" />
            <column caption="Subs Daily Avg" datatype="real" name="[subs_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Sdn Daily Avg" datatype="real" name="[sdn_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Rgb Daily Avg" datatype="real" name="[rgb_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Du Daily Avg" datatype="real" name="[du_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Payload User Daily Avg" datatype="real" name="[payload_user_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Digital User Daily Avg" datatype="real" name="[digital_user_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Games User Daily Avg" datatype="real" name="[games_user_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Video User Daily Avg" datatype="real" name="[video_user_daily_avg]" role="measure" type="quantitative" default-format="n#,##0.00" />
            <column caption="Payload Kelas" datatype="string" name="[payload_kelas]" role="dimension" type="nominal" />
            <column caption="Digital Kelas" datatype="string" name="[digital_kelas]" role="dimension" type="nominal" />
            <column caption="Games Kelas" datatype="string" name="[games_kelas]" role="dimension" type="nominal" />
            <column caption="Video Kelas" datatype="string" name="[video_kelas]" role="dimension" type="nominal" />
            <column caption="Kelas Terpilih" datatype="string" name="[Kelas]" role="dimension" type="nominal">
              <calculation class="tableau" formula="CASE [Parameters].[Kategori] WHEN &quot;Payload&quot; THEN [payload_kelas] WHEN &quot;Digital&quot; THEN [digital_kelas] WHEN &quot;Games&quot; THEN [games_kelas] WHEN &quot;Video&quot; THEN [video_kelas] END" />
            </column>
            <column caption="Rata-rata Harian" datatype="real" name="[Nilai]" role="measure" type="quantitative" default-format="n#,##0.00">
              <calculation class="tableau" formula="CASE [Parameters].[Kategori] WHEN &quot;Payload&quot; THEN [payload_user_daily_avg] WHEN &quot;Digital&quot; THEN [digital_user_daily_avg] WHEN &quot;Games&quot; THEN [games_user_daily_avg] WHEN &quot;Video&quot; THEN [video_user_daily_avg] END" />
            </column>
            <column caption="Bulan Terpilih" datatype="boolean" name="[BulanAktif]" role="dimension" type="nominal">
              <calculation class="tableau" formula="LEFT([month],7) = [Parameters].[Bulan]" />
            </column>
            <column caption="Site Kelas Tinggi" datatype="real" name="[PersenTinggi]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="COUNTD(IF [Kelas] = &quot;Tinggi&quot; THEN [site_id] END) / COUNTD([site_id])" />
            </column>
            <column caption="Rata-rata harian | Hari | Cakupan" datatype="string" name="[Detail]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR(ROUND([Nilai],2)) + &quot;   |   &quot; + STR(INT([days_observed])) + &quot; hari   |   &quot; + STR(ROUND([calendar_coverage]*100,1)) + &quot;%&quot;" />
            </column>
            <column-instance column="[Kelas]" derivation="None" name="[none:Kelas:nk]" pivot="key" type="nominal" />
            <column-instance column="[Nilai]" derivation="Median" name="[med:Nilai:qk]" pivot="key" type="quantitative" />
            <column-instance column="[site_id]" derivation="CountD" name="[ctd:site_id:qk]" pivot="key" type="quantitative" />
            <column-instance column="[PersenTinggi]" derivation="User" name="[usr:PersenTinggi:qk]" pivot="key" type="quantitative" />
            <column-instance column="[BulanAktif]" derivation="None" name="[none:BulanAktif:nk]" pivot="key" type="nominal" />
            <column-instance column="[site_id]" derivation="None" name="[none:site_id:nk]" pivot="key" type="nominal" />
            <column-instance column="[Detail]" derivation="None" name="[none:Detail:nk]" pivot="key" type="nominal" />
            <column-instance column="[Nilai]" derivation="Avg" name="[avg:Nilai:qk]" pivot="key" type="quantitative" />
            <column-instance column="[subs_daily_avg]" derivation="Avg" name="[avg:subs_daily_avg:qk]" pivot="key" type="quantitative" />
            <column-instance column="[du_daily_avg]" derivation="Avg" name="[avg:du_daily_avg:qk]" pivot="key" type="quantitative" />
            <column-instance column="[days_observed]" derivation="Avg" name="[avg:days_observed:qk]" pivot="key" type="quantitative" />
            <column-instance column="[calendar_coverage]" derivation="Avg" name="[avg:calendar_coverage:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Pilih Kategori" datatype="string" name="[Kategori]" param-domain-type="list" role="measure" type="nominal" value="&quot;Payload&quot;">
              <calculation class="tableau" formula="&quot;Payload&quot;" />
              <members>
                <member value="&quot;Payload&quot;" />
                <member value="&quot;Digital&quot;" />
                <member value="&quot;Games&quot;" />
                <member value="&quot;Video&quot;" />
              </members>
            </column>
            <column caption="Pilih Bulan" datatype="string" name="[Bulan]" param-domain-type="list" role="measure" type="nominal" value="&quot;2023-11&quot;">
              <calculation class="tableau" formula="&quot;2023-11&quot;" />
              <members>
                <member value="&quot;2023-11&quot;" />
                <member value="&quot;2023-12&quot;" />
                <member value="&quot;2024-01&quot;" />
                <member value="&quot;2024-02&quot;" />
                <member value="&quot;2024-03&quot;" />
                <member value="&quot;2024-04&quot;" />
                <member value="&quot;2024-05&quot;" />
                <member value="&quot;2024-06&quot;" />
                <member value="&quot;2024-07&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[kp].[none:BulanAktif:nk]">
            <groupfilter function="member" level="[none:BulanAktif:nk]" member="true" />
          </filter>
          <slices>
            <column>[kp].[none:BulanAktif:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="11" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[kp].[ctd:site_id:qk]" />
            </encodings>
            <style>
